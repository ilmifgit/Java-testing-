package password.validator;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.MethodSource;
import org.junit.jupiter.params.provider.NullAndEmptySource;
import org.junit.jupiter.params.provider.ValueSource;

import java.util.stream.Stream;

import static org.junit.jupiter.api.Assertions.*;

class PasswordValidatorTest {
    
    @ParameterizedTest
    @MethodSource("provideInvalidPasswords")
    void validatePassword_InvalidPasswords_ReturnsErrors(TestData testData) {
        ValidationResult result = PasswordValidator.validatePassword(testData.password);
        
        assertFalse(result.isSuccess());
        assertEquals(testData.expectedErrors.length, result.errors().size());
        
        for (String expectedError : testData.expectedErrors) {
            assertTrue(result.errors().contains(expectedError));
        }
    }
    
    private static Stream<TestData> provideInvalidPasswords() {
        return Stream.of(
            new TestData("Short1!", 
                "Пароль должен содержать не менее 8 символов. Текущая длина: 7",
                "Пароль должен содержать не менее 2 специальных символов. Найдено: 1"),
            new TestData("shortpassword1!",
                "Пароль должен содержать хотя бы одну заглавную букву",
                "Пароль должен содержать не менее 2 специальных символов. Найдено: 1"),
            new TestData("LONGPASSWORD1!",
                "Пароль должен содержать хотя бы одну строчную букву",
                "Пароль должен содержать не менее 2 специальных символов. Найдено: 1"),
            new TestData("NoDigits!",
                "Пароль должен содержать хотя бы одну цифру",
                "Пароль должен содержать не менее 2 специальных символов. Найдено: 1"),
            new TestData("ValidPass12",
                "Пароль должен содержать не менее 2 специальных символов. Найдено: 0")
        );
    }
    
    @ParameterizedTest
    @ValueSource(strings = {
        "ValidPass12!!",
        "P@ssw0rd!!123",
        "MyP@$$w0rd!!",
        "A1b@C#d$E%f2",
        "Test@123!!Pass"
    })
    void validatePassword_ValidPasswords_ReturnsSuccess(String password) {
        ValidationResult result = PasswordValidator.validatePassword(password);
        
        assertTrue(result.isSuccess());
        assertTrue(result.errors().isEmpty());
    }
    
    @ParameterizedTest
    @NullAndEmptySource
    @ValueSource(strings = {" ", "   ", "\t", "\n"})
    void validatePassword_NullOrBlank_ReturnsError(String password) {
        ValidationResult result = PasswordValidator.validatePassword(password);
        
        assertFalse(result.isSuccess());
        assertTrue(result.errors().contains("Пароль не может быть пустым"));
    }
    
    @ParameterizedTest
    @ValueSource(strings = {
        "TooLongPassword123!!",
        "VeryVeryLongPassword123!!",
        "ThisIsTooLongPassword123!!",
        "12345678901234567!!",
        "A1b@C#d$E%f2g3h4!"
    })
    void validatePassword_TooLongPasswords_ReturnsError(String password) {
        ValidationResult result = PasswordValidator.validatePassword(password);
        
        assertFalse(result.isSuccess());
        assertTrue(result.errors().stream()
            .anyMatch(error -> error.contains("не более 16 символов")));
    }
    
    @ParameterizedTest
    @ValueSource(strings = {
        "NOlower123!!",
        "ALLUPPER123!!",
        "UPPER1234!!",
        "CAPITAL123!!",
        "BIGLETTERS123!!"
    })
    void validatePassword_NoLowercase_ReturnsError(String password) {
        ValidationResult result = PasswordValidator.validatePassword(password);
        
        assertFalse(result.isSuccess());
        assertTrue(result.errors().contains("Пароль должен содержать хотя бы одну строчную букву"));
    }
    
    @ParameterizedTest
    @ValueSource(strings = {
        "noupper123!!",
        "alllower123!!",
        "lowercase123!!",
        "smallletters123!!",
        "onlylower123!!"
    })
    void validatePassword_NoUppercase_ReturnsError(String password) {
        ValidationResult result = PasswordValidator.validatePassword(password);
        
        assertFalse(result.isSuccess());
        assertTrue(result.errors().contains("Пароль должен содержать хотя бы одну заглавную букву"));
    }
    
    @ParameterizedTest
    @ValueSource(strings = {
        "NoDigitsUpperLower!!",
        "PasswordWithoutDigits!!",
        "OnlyLettersHere!!",
        "JustAlphaChars!!",
        "CharactersOnly!!"
    })
    void validatePassword_NoDigits_ReturnsError(String password) {
        ValidationResult result = PasswordValidator.validatePassword(password);
        
        assertFalse(result.isSuccess());
        assertTrue(result.errors().contains("Пароль должен содержать хотя бы одну цифру"));
    }
    
    @ParameterizedTest
    @ValueSource(strings = {
        "OnlyOne!Digit1",
        "OneSpecial@Char1",
        "Test#Password1",
        "Hello$World1",
        "Sample%Text1"
    })
    void validatePassword_OnlyOneSpecialChar_ReturnsError(String password) {
        ValidationResult result = PasswordValidator.validatePassword(password);
        
        assertFalse(result.isSuccess());
        assertTrue(result.errors().stream()
            .anyMatch(error -> error.contains("не менее 2 специальных символов")));
    }
    
    @Test
    void validatePassword_AllRulesViolated_ReturnsAllErrors() {
        ValidationResult result = PasswordValidator.validatePassword("short");
        
        assertFalse(result.isSuccess());
        assertEquals(5, result.errors().size());
    }
    
    @ParameterizedTest
    @ValueSource(strings = {
        "Valid12!!",
        "P@ssw0rd!!",
        "A1b@C#d$",
        "Test@123!!",
        "MyP@$$12!!"
    })
    void validatePassword_BoundaryLengthValid_ReturnsSuccess(String password) {
        ValidationResult result = PasswordValidator.validatePassword(password);
        
        assertTrue(result.isSuccess());
        assertTrue(result.errors().isEmpty());
    }
    
    private static class TestData {
        final String password;
        final String[] expectedErrors;
        
        TestData(String password, String... expectedErrors) {
            this.password = password;
            this.expectedErrors = expectedErrors;
        }
    }
}
